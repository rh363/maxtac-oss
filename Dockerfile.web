# Dashboard web: build della SPA con Node, poi solo Python. Nessun segreto del bot, nessun
# socket Docker: vedi il servizio `web` nel compose.
FROM node:22.22.0-bookworm-slim AS frontend
WORKDIR /src/frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY web/theme-terms.json /src/web/theme-terms.json
COPY frontend/ ./
# `npm run build` controlla anche che il bundle non contenga nulla del tema alternativo
RUN npm run build

FROM python:3.13-slim-bookworm
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates tini \
 && rm -rf /var/lib/apt/lists/*
COPY --from=ghcr.io/astral-sh/uv:0.11.30 /uv /usr/local/bin/uv

ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_PROJECT_ENVIRONMENT=/opt/autofix
WORKDIR /app
COPY pyproject.toml uv.lock README.md ./
RUN uv sync --frozen --no-dev --extra web --no-install-project
COPY src ./src
RUN uv sync --frozen --no-dev --extra web
# Il progetto è installato editable: la build sta dove la cerca default_static_dir()
COPY --from=frontend /src/frontend/build ./frontend/build

RUN groupadd -g 1000 autofix && useradd -u 1000 -g 1000 -M -d /nonexistent -s /usr/sbin/nologin autofix
USER 1000:1000
ENV PATH=/opt/autofix/bin:$PATH AUTOFIX_CONFIG=/etc/autofix/config.yaml

ENTRYPOINT ["tini", "--", "autofix"]
CMD ["web"]
